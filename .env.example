# Banco do OS Service, usuário somente leitura `auth_reader`, com search_path=auth
# (driver psycopg, SEM o prefixo +asyncpg).
DATABASE_URL=postgresql://auth_reader:senha@ep-xxx.us-east-2.aws.neon.tech/autogiro_os?sslmode=require&options=-csearch_path%3Dauth

# Mesmo segredo configurado no Kong e nos microsserviços: esta Lambda assina o
# token e eles validam a assinatura.
JWT_SECRET=change-this-secret-key-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
