# Connection string do Neon (driver psycopg — SEM o prefixo +asyncpg).
DATABASE_URL=postgresql://user:senha@ep-xxx.neon.tech/autogiro?sslmode=require

# Mesmo segredo configurado no repositório autogiro-app: esta Lambda assina o
# token e a API valida a assinatura.
JWT_SECRET=change-this-secret-key-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
