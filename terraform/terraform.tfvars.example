# Copie para terraform.tfvars e preencha. NÃO comite o arquivo preenchido.

aws_region  = "us-east-1"
environment = "homolog"

# Banco do OS Service, usuário somente leitura `auth_reader` (saída
# `auth_database_url` do terraform/ do autogiro-os-service). O search_path vai na
# URL, para a consulta `FROM clients` ler a view auth.clients.
database_url = "postgresql://auth_reader:senha@ep-xxx.us-east-2.aws.neon.tech/autogiro_os?sslmode=require&options=-csearch_path%3Dauth"

# Mesmo segredo configurado no Kong (autogiro-infra-k8s) e nos microsserviços.
jwt_secret = "gere-com-python-c-import-secrets-print-secrets-token_urlsafe-48"
